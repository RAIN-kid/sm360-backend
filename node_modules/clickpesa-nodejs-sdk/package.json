{
  "name": "clickpesa-nodejs-sdk",
  "version": "0.1.0",
  "description": "Production-grade Node.js SDK for the ClickPesa API — collections, payouts, BillPay, hosted links, webhooks and more. Works with Express, NestJS, Next.js and every Node app.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-cjs-package.js",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/fix-cjs-package.js",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "clickpesa",
    "payments",
    "fintech",
    "tanzania",
    "sdk",
    "api",
    "express",
    "nestjs",
    "nextjs"
  ],
  "author": "mbombwe-jr",
  "license": "MIT",
  "homepage": "https://github.com/mbombwe-jr/clickpesa-nodejs-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mbombwe-jr/clickpesa-nodejs-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mbombwe-jr/clickpesa-nodejs-sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {}
}